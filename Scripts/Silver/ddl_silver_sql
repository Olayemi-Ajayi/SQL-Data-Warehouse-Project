/*==============================================================================
DDL Script: Create Silver Layer Tables
Database: Datawarehouse
Schema:   silver
Purpose:  Creates clean, typed Silver tables for CRM and ERP datasets with
          standard audit metadata (dwh_create_date).
==============================================================================*/

USE Datawarehouse;
GO

-- 1. silver.crm_customers
IF OBJECT_ID('silver.crm_customers', 'U') IS NOT NULL
    DROP TABLE silver.crm_customers;
GO

CREATE TABLE silver.crm_customers (
    customer_id     INT,
    first_name      NVARCHAR(100),
    last_name       NVARCHAR(100),
    email           NVARCHAR(255),
    signup_date     DATETIME2,
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

-- 2. silver.crm_interactions
IF OBJECT_ID('silver.crm_interactions', 'U') IS NOT NULL
    DROP TABLE silver.crm_interactions;
GO

CREATE TABLE silver.crm_interactions (
    interaction_id  INT,
    customer_id     INT,
    channel         NVARCHAR(50),
    status          NVARCHAR(50),
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

-- 3. silver.crm_support_tickets
IF OBJECT_ID('silver.crm_support_tickets', 'U') IS NOT NULL
    DROP TABLE silver.crm_support_tickets;
GO

CREATE TABLE silver.crm_support_tickets (
    tickets_id      INT,
    customer_id     INT,
    issue_category  NVARCHAR(100),
    priority        NVARCHAR(50),
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

-- 4. silver.erp_orders
IF OBJECT_ID('silver.erp_orders', 'U') IS NOT NULL
    DROP TABLE silver.erp_orders;
GO

CREATE TABLE silver.erp_orders (
    order_id        INT,
    customer_id     INT,
    order_date      DATETIME2,
    order_status    NVARCHAR(50),
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

-- 5. silver.erp_order_items
IF OBJECT_ID('silver.erp_order_items', 'U') IS NOT NULL
    DROP TABLE silver.erp_order_items;
GO

CREATE TABLE silver.erp_order_items (
    order_item_id   INT,
    order_id        INT,
    product_id      INT,
    quantity        INT,
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO

-- 6. silver.erp_products
IF OBJECT_ID('silver.erp_products', 'U') IS NOT NULL
    DROP TABLE silver.erp_products;
GO

CREATE TABLE silver.erp_products (
    product_id      INT,
    product_name    NVARCHAR(150),
    category        NVARCHAR(100),
    price           DECIMAL(18, 2),
    dwh_create_date DATETIME2 DEFAULT GETDATE()
);
GO
